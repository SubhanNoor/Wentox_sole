{
  "name": "wentox-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Wentox ERP backend — local Express API served inside the Electron desktop app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seeds/run.js",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm:dev\" \"npm --prefix ../frontend run dev\" \"electron .\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.1.4"
  }
}
