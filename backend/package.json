{
  "name": "wentox-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Wentox ERP — Electron desktop app; renderer and backend logic talk over IPC, no HTTP server",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seeds/run.js",
    "seed:dev": "node src/db/seeds/dev-sample-data.js",
    "electron:dev": "concurrently \"npm --prefix ../frontend run dev\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.1.4"
  }
}
